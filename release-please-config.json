{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "@lehcode/multilint",
      "extra-files": [
        { "type": "json", "path": "opencode-plugin/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "opencode-plugin/package-lock.json", "jsonpath": "$.version" }
      ],
      "changelog-path": "CHANGELOG.md",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "draft": false,
      "prerelease": false
    }
  }
}
