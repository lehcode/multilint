{
  "name": "@lehcode/multilint",
  "version": "0.2.0",
  "description": "Provides agentic linting behavior by auto-registering the Multilint MCP server dual-mode plugin for OpenCode V1/V2.",
  "keywords": [
    "lint",
    "agent",
    "opencode"
  ],
  "homepage": "https://github.com/lehcode/multilint",
  "bugs": {
    "url": "https://github.com/lehcode/multilint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lehcode/multilint.git"
  },
  "license": "MIT",
  "author": "Anton Repin",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/dual.d.ts",
      "import": "./dist/dual.js"
    }
  },
  "main": "./dist/dual.js",
  "types": "./dist/dual.d.ts",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "files": [
    "dist/",
    "agents/"
  ],
  "scripts": {
    "build:js": "esbuild src/dual.ts --bundle --platform=node --minify --format=esm --external:@opencode/plugin --outfile=dist/dual.js",
    "build:types": "tsc -p tsconfig.json",
    "build": "npm run build:js && npm run build:types",
    "build:watch": "esbuild src/dual.ts --bundle --platform=node --format=esm --external:@opencode/plugin --outfile=dist/dual.js --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@opencode/plugin": "^2.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^1.0.0 || ^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
