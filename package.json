{
  "name": "@lehcode/multilint",
  "version": "0.2.1",
  "description": "OpenCode plugin that lints each edited file on the host with multilint. Missing linters are reported as skipped.",
  "keywords": [
    "lint",
    "agent",
    "claude code",
    "opencode"
  ],
  "homepage": "https://github.com/lehcode/multilint",
  "bugs": {
    "url": "https://github.com/lehcode/multilint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lehcode/multilint.git"
  },
  "license": "MIT",
  "author": "Anton Repin",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "scripts/",
    "hooks/",
    ".claude-plugin/"
  ],
  "scripts": {
    "build:js": "esbuild src/index.ts --bundle --platform=node --minify --format=esm --external:@opencode/plugin --outfile=dist/index.js",
    "build:types": "tsc -p tsconfig.json",
    "build": "npm run build:js && npm run build:types",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@opencode/plugin --outfile=dist/index.js --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@opencode/plugin": "^2.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^1.0.0 || ^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
