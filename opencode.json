{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "agent": {
    "multilint": {
      "description": "Run code quality linting via the multilint service.",
      "prompt": "{file:./agents/multilint.md}"
    }
  },
  "mcp": {
    "multilint": {
      "type": "remote",
      "url": "http://localhost:8592/mcp"
    }
  }
}
